# Copy to tutor/.env (git ignores .env) and fill in real values.
# Django platform
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql://tutor:CHANGE_ME@localhost:5432/tutor_dev
# Tester tools (/api/v1/dev/outbox, seed_test_accounts). Local only; ignored unless DJANGO_DEBUG=true.
TUTOR_DEV_TOOLS=true

# Production only (set on Render, not here)
# DJANGO_COOKIE_DOMAIN=.tutor.org.in
# DJANGO_HSTS_SECONDS=3600

# Reverse proxies in front of Django that add X-Forwarded-For (local: 0, Render: 1). Used for rate limits.
TUTOR_TRUSTED_PROXIES=0

# AI service (milestone 5). Local development uses your own Ollama; tests always use "mock".
# See docs/engineering/development.md "AI tutor locally (Ollama)".
TUTOR_AI_PROVIDER=ollama
TUTOR_OLLAMA_URL=http://localhost:11434
TUTOR_OLLAMA_CHAT_MODEL=llama3.2
TUTOR_OLLAMA_EMBED_MODEL=nomic-embed-text

# Demo world and test suites: courses, people and history for testing (never in production). Password shared by demo accounts and test runners.
TUTOR_DEMO_DATA=true
TUTOR_DEMO_PASSWORD=Test-Pass-2026

# Local rotating log files go to backend/logs/ by default. Uncomment to move them, or leave empty to switch files off.
# TUTOR_LOG_DIR=

# AI service (ai/). Locally the same database as DATABASE_URL (its tables live in schema "ai").
AI_DATABASE_URL=postgresql://tutor:<password>@localhost:5432/tutor_dev
# Shared secret: Django sends it, the AI service checks it. At least 32 random characters, different per environment:
#   python3 -c "import secrets; print(secrets.token_urlsafe(40))"
TUTOR_AI_SERVICE_TOKEN=<random>
TUTOR_AI_URL=http://localhost:8001
# Lesson index sync (sync_ai_index). Defaults shown; leave commented unless you need to change them.
# TUTOR_AI_INDEX_TIMEOUT_SECONDS=120
# TUTOR_AI_INDEX_ON_PUBLISH=true
